# PostgreSQL
POSTGRES_USER=aizen
POSTGRES_PASSWORD=aizenpw
POSTGRES_DB=inktavia_store

# MongoDB
MONGO_USER=aizen
MONGO_PASSWORD=aizenpw

# Redis
# (no auth by default)

# Keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=keycloakpw
KC_DB_NAME=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_HOSTNAME=http://localhost:8080
KC_REALM=inktavia-realm
KC_CLIENT_ID=aizen-client
KC_CLIENT_SECRET=changeme

# RabbitMQ
RABBITMQ_USER=aizen
RABBITMQ_PASSWORD=aizenpw
RABBITMQ_VHOST=/

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Port overrides
GATEWAY_PORT=18000
BFF_PORT=17000

# MinIO - Local object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=inktavia-filestorage-local

# Provider Portal BFF — Keycloak client secret (generate with: openssl rand -hex 24)
KEYCLOAK_PROVIDER_BFF_CLIENT_SECRET=REPLACE_ME

# Provider Password Recovery — DEV-ONLY OTP exposure (identity-api).
# Leave FALSE everywhere except a local machine where you need to read the OTP from logs.
# NEVER set true in shared/test/production. Requires the Debug log level to actually print the code.
PASSWORD_RECOVERY_DEV_EXPOSE_OTP=false
PASSWORD_RECOVERY_LOG_LEVEL=Information

# Password Recovery — delivery mode for identity-api
# "Notification" (default) publishes OTP to message bus for real email/SMS delivery.
# "Logging" logs intent only (local dev without SMTP).
PASSWORD_RECOVERY_DELIVERY_MODE=Notification

# SMTP — notification-api email delivery (leave blank to use the logging stub)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@inktavia.com
SMTP_FROM_NAME=Inktavia Marine
SMTP_USE_SSL=true

# OTP Login ticket secrets — shared between identity-api and the Keycloak SPI (DO NOT COMMIT)
# Generate: openssl rand -hex 32
OTP_LOGIN_TICKET_SECRET=
OTP_LOGIN_CONSUME_SECRET=

# S3 Object Storage (override for cloud environments - do NOT commit real values)
# S3ObjectStorage__Provider=AWS
# S3ObjectStorage__AccessKey=YOUR_AWS_ACCESS_KEY
# S3ObjectStorage__SecretKey=YOUR_AWS_SECRET_KEY
# S3ObjectStorage__Region=eu-central-1
# S3ObjectStorage__BucketName=inktavia-filestorage-dev
# S3ObjectStorage__ServiceUrl=
# S3ObjectStorage__ForcePathStyle=false
# S3ObjectStorage__UseHttp=false

# MinIO browser-reachable URL for presigned URLs (local dev). In production this is the real S3/CDN endpoint.
MINIO_PUBLIC_URL=http://localhost:9000
KEYCLOAK_MARINE_MOBILE_BFF_CLIENT_SECRET=local-dev-only-change-me
BFF_MARINE_MOBILE_PORT=17003
MARINE_MOBILE_BASE=http://localhost:19006

# ── Marine.Web BFF (public website / server-rendered Next.js consumer) ──────────
# Content module host port (Mongo-only module the Marine.Web BFF reads via IContentRemoteCall).
CONTENT_API_PORT=7111
# Marine.Web BFF host port.
BFF_MARINE_WEB_PORT=17005
# Base URL of the Next.js site — used for CORS + the revalidation webhook target.
MARINE_WEB_BASE=http://localhost:3000
# W2.1 trusted server-caller secret. The SAME value MUST be injected into the Next.js server as the
# X-Aizen-Web-Caller header, or the SSR server trips the strict per-IP read limit.
MARINE_WEB_TRUSTED_CALLER_SECRET=local-dev-only-change-me
# W2.2 secret the BFF sends to the Next.js /api/revalidate endpoint (leave empty to disable the webhook locally).
MARINE_WEB_REVALIDATE_SECRET=
# Confidential service-account secret for the marine-web-bff Keycloak client (service token for BFF→module calls).
KEYCLOAK_MARINE_WEB_BFF_CLIENT_SECRET=local-dev-only-change-me

# --- Yuk testi (LT serisi, dev-only) ---
# k6 test kullanicilarinin ortak sifresi (setup-keycloak-loadtest.sh ayni degeri Keycloak'a yazar)
LOADTEST_USER_PASSWORD=
