# PostgreSQL
POSTGRES_USER=aizen
POSTGRES_PASSWORD=aizenpw
POSTGRES_DB=aizen

# MongoDB
MONGO_USER=aizen
MONGO_PASSWORD=aizenpw

# Redis
# (no auth by default)

# Keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=keycloakpw
KC_DB_NAME=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_HOSTNAME=http://localhost:8080
KC_REALM=inktavia-realm
KC_CLIENT_ID=aizen-client
KC_CLIENT_SECRET=changeme

# RabbitMQ
RABBITMQ_USER=aizen
RABBITMQ_PASSWORD=aizenpw
RABBITMQ_VHOST=/

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Port overrides
GATEWAY_PORT=18000
BFF_PORT=17000

# MinIO - Local object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=inktavia-filestorage-local

# Provider Portal BFF — Keycloak client secret (generate with: openssl rand -hex 24)
KEYCLOAK_PROVIDER_BFF_CLIENT_SECRET=REPLACE_ME

# S3 Object Storage (override for cloud environments - do NOT commit real values)
# S3ObjectStorage__Provider=AWS
# S3ObjectStorage__AccessKey=YOUR_AWS_ACCESS_KEY
# S3ObjectStorage__SecretKey=YOUR_AWS_SECRET_KEY
# S3ObjectStorage__Region=eu-central-1
# S3ObjectStorage__BucketName=inktavia-filestorage-dev
# S3ObjectStorage__ServiceUrl=
# S3ObjectStorage__ForcePathStyle=false
# S3ObjectStorage__UseHttp=false
