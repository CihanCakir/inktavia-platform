{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Admin Panel BFF — Controller API Tests",
    "description": "Per-endpoint tests for every Admin Panel BFF controller action. Requires the 'Admin Panel BFF - Local' environment.",
