{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ElasticApm": {
    "ServerUrl": "",
    "TransactionSampleRate": 1.0,
    "CaptureHeaders": "true",
    "CaptureBody": "all",
    "CaptureBodyContentTypes": "application/json*",
    "OpentelemetryBridgeEnabled": false,
    "TransactionIgnoreUrls": "/api/health, /info"
  },
  "MessageBroker": {
    "QueueSettings": {
      "HostName": "localhost",
      "UserName": "guest",
      "Password": "guest",
      "Port": 5672,
      "VirtualHost": "/",
      "Debug": false
    }
  },
  "DistributedCache": {
    "InstanceName": "MarineMobileBff:",
    "Configuration": "__FROM_ENV__"
  },
  "MarineMobileKeycloak": {
    "BaseUrl": "__FROM_ENV__",
    "Authority": "__FROM_ENV__",
    "MetadataAddress": "__FROM_ENV__",
    "Realm": "inktavia-realm",
    "Audience": "marine-mobile-bff",
    "RequireHttpsMetadata": "false",
    "AdminClientId": "marine-mobile-bff",
    "AdminClientSecret": "__FROM_SECRET__",
    "ClientId": "inktavia-mobile",
    "BffClientId": "marine-mobile-bff",
    "MobileUserRole": "mobile_user",
    "ParticipantProfileIdAttributeName": "participant_profile_id",
    "VerifyEmailRedirectUri": "__FROM_ENV__",
    "BffRedirectUri": "__FROM_ENV__"
  },
  "RateLimiting": {
    "PasswordRecovery": {
      "PermitPerWindow": 10,
      "WindowSeconds": 300
    }
  },
  "RemoteCalls": {
    "IIdentityRemoteCall": {
      "BaseUrl": "__FROM_ENV__",
      "DefaultHeaders": {}
    },
    "IReferenceDataRemoteCall": {
      "BaseUrl": "__FROM_ENV__",
      "DefaultHeaders": {}
    },
    "IVesselRemoteCall": {
      "BaseUrl": "__FROM_ENV__",
      "DefaultHeaders": {}
    },
    "IServiceRequestRemoteCall": {
      "BaseUrl": "__FROM_ENV__",
      "DefaultHeaders": {}
    },
    "IParticipantMembershipRemoteCall": {
      "BaseUrl": "__FROM_ENV__",
      "DefaultHeaders": {}
    }
  }
}
