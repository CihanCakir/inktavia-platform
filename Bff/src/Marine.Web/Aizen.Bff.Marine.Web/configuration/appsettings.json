{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ElasticApm": {
    "ServerUrl": "",
    "TransactionSampleRate": 1.0,
    "CaptureHeaders": "true",
    "CaptureBody": "all",
    "CaptureBodyContentTypes": "application/json*",
    "OpentelemetryBridgeEnabled": false,
    "TransactionIgnoreUrls": "/api/health, /info"
  },
  "MessageBroker": {
    "QueueSettings": {
      "HostName": "localhost",
      "UserName": "guest",
      "Password": "guest",
      "Port": 5672,
      "VirtualHost": "/",
      "Debug": false
    }
  },
  "DistributedCache": {
    "InstanceName": "MarineWebBff:",
    "Configuration": "__FROM_ENV__"
  },
  "MarineWebKeycloak": {
    "BaseUrl": "__FROM_ENV__",
    "Authority": "__FROM_ENV__",
    "MetadataAddress": "__FROM_ENV__",
    "Realm": "inktavia-realm",
    "Audience": "marine-web-bff",
    "RequireHttpsMetadata": "false",
    "AdminClientId": "marine-web-bff",
    "AdminClientSecret": "__FROM_SECRET__",
    "ClientId": "inktavia-web",
    "BffClientId": "marine-web-bff",
    "WebUserRole": "web_user",
    "ParticipantProfileIdAttributeName": "participant_profile_id",
    "ModuleAssertionSecret": "__FROM_SECRET__"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PublicRead": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    }
  },
  "MarineWebPublic": {
    "TrustedCallerSecret": "__FROM_SECRET__",
    "TrustedRateLimit": {
      "PermitLimit": 6000,
      "WindowSeconds": 60
    },
    "Revalidate": {
      "Url": "__FROM_ENV__",
      "Secret": "__FROM_SECRET__"
    },
    "Seo": {
      "RequirePublished": true,
      "RequireTitle": true,
      "RequireDescription": false,
      "MinBodyLength": 200
    }
  },
  "RemoteCalls": {
    "IContentRemoteCall": {
      "BaseUrl": "__FROM_ENV__",
      "DefaultHeaders": {}
    },
    "IReferenceDataRemoteCall": {
      "BaseUrl": "__FROM_ENV__",
      "DefaultHeaders": {}
    },
    "IIdentityRemoteCall": {
      "BaseUrl": "__FROM_ENV__",
      "DefaultHeaders": {}
    },
    "IPaymentPlanRemoteCall": {
      "BaseUrl": "__FROM_ENV__",
      "DefaultHeaders": {}
    }
  }
}
