{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ElasticApm": {
    "ServerUrl": "",
    "TransactionSampleRate": 1.0,
    "CaptureHeaders": "true",
    "CaptureBody": "all",
    "CaptureBodyContentTypes": "application/json*",
    "OpentelemetryBridgeEnabled": false,
    "TransactionIgnoreUrls": "/api/health, /info"
  },
  "MessageBroker": {
    "QueueSettings": {
      "HostName": "localhost",
      "UserName": "guest",
      "Password": "guest",
      "Port": 5672,
      "VirtualHost": "/",
      "Debug": false
    }
  },
  "DistributedCache": {
    "InstanceName": "MarineProviderBff:",
    "Configuration": "__FROM_ENV__"
  },
  "MarineProviderKeycloak": {
    "BaseUrl": "__FROM_ENV__",
    "Authority": "__FROM_ENV__",
    "MetadataAddress": "__FROM_ENV__",
    "Realm": "inktavia-realm",
    "Audience": "provider-portal-bff",
    "RequireHttpsMetadata": "false",
    "AdminClientId": "provider-portal-bff",
    "AdminClientSecret": "__FROM_SECRET__",
    "ProviderPortalClientId": "provider-portal",
    "ProviderPortalBffClientId": "provider-portal-bff",
    "ProviderPendingRole": "provider_pending",
    "ProviderUserRole": "provider_user",
    "ProviderRestrictedRole": "provider_restricted",
    "ProviderProfileIdAttributeName": "provider_profile_id"
  },
  "RateLimiting": {
    "PasswordRecovery": {
      "PermitPerWindow": 10,
      "WindowSeconds": 300
    }
  },
  "RemoteCalls": {
    "IIdentityRemoteCall": {
      "BaseUrl": "__FROM_ENV__",
      "DefaultHeaders": {}
    },
    "IServiceRequestRemoteCall": {
      "BaseUrl": "__FROM_ENV__",
      "DefaultHeaders": {}
    },
    "IFileStorageRemoteCall": {
      "BaseUrl": "__FROM_ENV__",
      "DefaultHeaders": {}
    },
    "INotificationRemoteCall": {
      "BaseUrl": "__FROM_ENV__",
      "DefaultHeaders": {}
    },
    "IReferenceDataRemoteCall": {
      "BaseUrl": "__FROM_ENV__",
      "DefaultHeaders": {}
    },
    "IVesselRemoteCall": {
      "BaseUrl": "__FROM_ENV__",
      "DefaultHeaders": {}
    },
    "ICargoDryRemoteCall": {
      "BaseUrl": "__FROM_ENV__",
      "DefaultHeaders": {}
    }
  }
}
