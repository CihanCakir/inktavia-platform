  "Scheduler": {
    "StorageType": "PostgreSQL",
    "RetryAttempts": 3,
    "UseFilter": true,
    "RouteUrl": "/hangfire",
    "DatabaseKey": "CargoDryScheduler",
    "SchemaName": "cargodry-scheduler"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MongoDB.Driver": "Warning"
    }
  }
