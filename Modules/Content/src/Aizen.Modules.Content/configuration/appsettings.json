{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MongoDB.Driver": "Warning"
    }
  },
  "DatabaseSettings": {
    "ContentMongo": {
      "Type": "Mongo",
      "ConnectionString": "mongodb://root:example@localhost:27017/aizen_content?authSource=admin"
    }
  },
  "DistributedCache": {
    "InstanceName": "Content:",
    "Configuration": "localhost:6379,abortConnect=False"
  },
  "MessageBroker": {
    "QueueSettings": {
      "HostName": "localhost",
      "UserName": "guest",
      "Password": "guest",
      "Port": 5672,
      "VirtualHost": "/",
      "Debug": false
    }
  },
  "Content": {
    "Comments": {
      "PreModeration": true
    },
    "Languages": {
      "Supported": [ "tr", "en" ]
    },
    "Seed": {
      "Demo": false
    },
    "RateLimiting": {
      "PublicRead": {
        "PermitLimit": 120,
        "WindowSeconds": 60
      }
    }
  },
  "RemoteCalls": {
    "IFileStorageRemoteCall": {
      "BaseUrl": "http://localhost:7106"
    }
  }
}
