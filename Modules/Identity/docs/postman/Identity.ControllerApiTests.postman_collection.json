                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Set Active - Admin",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{identity_api_base_url}}/health",
              "host": ["{{identity_api_base_url}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set('active_access_token', pm.environment.get('admin_access_token'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Identity Login - Phone",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+905301234567\",\n  \"password\": \"{{default_password}}\",\n  \"deviceId\": \"test-device-001\",\n  \"notificationToken\": \"fcm-test\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{identity_api_base_url}}/auth/login/phone",
              "host": ["{{identity_api_base_url}}"],
              "path": ["auth", "login", "phone"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "pm.environment.set('identityAccessToken', r.identityAccessToken || r.accessToken || '');",
                  "pm.environment.set('X-Aizen-User-Token', r.xAizenUserToken || r.userToken || '');",
                  "pm.environment.set('identityRefreshToken', r.refreshToken || '');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
