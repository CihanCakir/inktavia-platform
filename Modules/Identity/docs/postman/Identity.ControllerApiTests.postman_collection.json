  "item": [
    {
      "name": "00 - Auth Setup",
      "item": [
        {
          "name": "Get Mobile Token",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "client_id", "value": "{{mobile_client_id}}", "type": "text" },
                { "key": "username", "value": "{{mobile_username}}", "type": "text" },
                { "key": "password", "value": "{{default_password}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{keycloak_token_url}}",
              "host": ["{{keycloak_token_url}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "pm.environment.set('mobile_access_token', r.access_token);",
                  "pm.environment.set('active_access_token', r.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Admin Token",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "client_id", "value": "{{admin_panel_client_id}}", "type": "text" },
                { "key": "username", "value": "{{admin_username}}", "type": "text" },
                { "key": "password", "value": "{{default_password}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{keycloak_token_url}}",
              "host": ["{{keycloak_token_url}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "pm.environment.set('admin_access_token', r.access_token);",
                  "pm.environment.set('active_access_token', r.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Set Active - Mobile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{identity_api_base_url}}/health",
              "host": ["{{identity_api_base_url}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set('active_access_token', pm.environment.get('mobile_access_token'));"
