{
  "MockData": {
    "Enabled": true,
    "RunOnStartup": true,
    "EnvironmentGuard": ["Local", "Development"],
    "SeedMode": "InsertMissingOnly",
    "DataSet": "admin-demo"
  },
  "NotificationSeed": {
    "Enabled": true,
    "SeedEfEntities": true,
    "JsonRootPath": "Seed/Json",
    "FailOnMissingRequiredFile": false
  },
  "DatabaseSettings": {
    "Notification": {
      "Type": "PostgreSQL",
      "ConnectionString": "Host=postgres;Port=5432;Database=inktavia_store;Username=aizen;Password=aizenpw"
    }
  },
  "ConnectionStrings": {
    "Notification": "Host=postgres;Port=5432;Database=inktavia_store;Username=aizen;Password=aizenpw"
  },
  "DistributedCache": {
    "InstanceName": "Notification:",
    "Configuration": "redis:6379,abortConnect=False,defaultDatabase=13"
  },
  "MessageBroker": {
    "QueueSettings": {
      "HostName": "rabbitmq",
      "UserName": "aizen",
      "Password": "aizenpw",
      "Port": 5672,
      "VirtualHost": "/",
      "Debug": false
    }
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/inktavia-realm",
    "MetadataAddress": "http://keycloak:8080/realms/inktavia-realm/.well-known/openid-configuration",
    "Audience": "notification-api",
    "RequireHttpsMetadata": "false"
  },
  "ErrorLocalization": {
    "Assembly": "Aizen.Modules.Notification",
    "ResourceFolder": "Resource",
    "ResourceFile": "aizen_error_messages.json"
  },
  "ElasticApm": {
    "Enabled": false,
    "TransactionIgnoreUrls": "/api/health, /info"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
