{
  "ContactIntake": {
    "SpamThreshold": 50,
    "RateWindowMinutes": 10,
    "RateMaxPerWindow": 3,
    "MaxLinks": 2,
    "IpHashSalt": "__FROM_SECRET__"
  },
  "MockData": {
    "Enabled": false,
    "RunOnStartup": false,
    "EnvironmentGuard": ["Local", "Development"],
    "SeedMode": "InsertMissingOnly",
    "DataSet": "admin-demo"
  },
  "NotificationSeed": {
    "Enabled": false,
    "SeedEfEntities": false,
    "JsonRootPath": "Seed/Json",
    "FailOnMissingRequiredFile": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ElasticApm": {
    "ServerUrl": "",
    "TransactionSampleRate": 1.0,
    "CaptureHeaders": "true",
    "CaptureBody": "all",
    "CaptureBodyContentTypes": "application/json*",
    "OpentelemetryBridgeEnabled": false,
    "TransactionIgnoreUrls": "/api/health, /info"
  },
  "DatabaseSettings": {
    "Notification": {
      "Type": "PostgreSQL",
      "ConnectionString": "Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=postgres;Maximum Pool Size=300"
    }
  },
  "DistributedCache": {
    "InstanceName": "Notification:",
    "Configuration": "localhost:6379,abortConnect=False,defaultDatabase=13"
  },
  "MessageBroker": {
    "QueueSettings": {
      "HostName": "localhost",
      "UserName": "guest",
      "Password": "guest",
      "Port": 5672,
      "VirtualHost": "/",
      "Debug": false
    }
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "FromAddress": "no-reply@inktavia.com",
    "FromName": "Inktavia Marine",
    "UseSsl": true,
    "ReplyTo": "info@inktavia.com"
  },
  "Sms": {
    "Provider": "stub",
    "DefaultCountryCode": "+90",
    "Infobip": {
      "BaseUrl": "",
      "ApiKey": "",
      "From": ""
    },
    "Netgsm": {
      "BaseUrl": "https://api.netgsm.com.tr",
      "UserCode": "",
      "Password": "",
      "MsgHeader": ""
    }
  },
  "Notification": {
    "DefaultLocale": "tr",
    "AllowedLocales": [ "tr", "en" ]
  },
  "PushNotification": {
    "Firebase": {
      "Type": "service_account",
      "ProjectId": "",
      "PrivateKeyId": "",
      "ClientId": "",
      "ClientEmail": "",
      "AuthUri": "https://accounts.google.com/o/oauth2/auth",
      "AuthProviderX509CertUrl": "https://www.googleapis.com/oauth2/v1/certs",
      "TokenUri": "https://oauth2.googleapis.com/token",
      "ClientX509CertUrl": ""
    }
  }
}
