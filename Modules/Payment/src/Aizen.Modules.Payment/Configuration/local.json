{
  "ConnectionStrings": {
    "Payment": "Host=localhost;Port=5432;Database=aizen_payment;Username=postgres;Password=postgres;Pooling=true;MinPoolSize=1;MaxPoolSize=10"
  },
  "Payment": {
    "GatewayActive": "manual",
    "EscrowTimeoutHours": 2,
    "EscrowTimeoutBatch": 200,
    "ReminderWindowsHours": [ 1, 24 ],
    "ReminderBatch": 500,
    "StaleCleanupDays": 7,
    "StaleCleanupBatch": 500,
    "PayoutAutoRetryHours": 48,
    "PayoutBatch": 200
  },
  "Iyzico": {
    "ApiKey": "sandbox-api-key",
    "SecretKey": "sandbox-secret-key",
    "BaseUrl": "https://sandbox-api.iyzipay.com",
    "WebhookSecret": "",
    "CallbackUrl": "http://localhost:3000/payment/callback",
    "Locale": "tr"
  },
  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "Port": 5672
  },
  "DistributedCache": {
    "Configuration": "localhost:6379,abortConnect=false"
  },
  "DatabaseSettings": {
    "PaymentScheduler": {
      "Type": "PostgreSQL",
      "ConnectionString": "Host=localhost;Port=5432;Database=aizen_payment;Username=postgres;Password=postgres"
    }
  },
  "Scheduler": {
    "StorageType": "PostgreSQL",
    "RetryAttempts": 3,
    "UseFilter": true,
    "RouteUrl": "/hangfire",
    "DatabaseKey": "PaymentScheduler",
    "SchemaName": "payment-scheduler"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
