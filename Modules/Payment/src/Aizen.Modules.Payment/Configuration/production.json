{
  "ConnectionStrings": {
    "Payment": "#{ConnectionStrings_Payment}#"
  },
  "Payment": {
    "GatewayActive": "#{Payment_GatewayActive}#",
    "EscrowTimeoutHours": "#{Payment_EscrowTimeoutHours}#",
    "EscrowTimeoutBatch": "#{Payment_EscrowTimeoutBatch}#",
    "ReminderWindowsHours": "#{Payment_ReminderWindowsHours}#",
    "ReminderBatch": "#{Payment_ReminderBatch}#",
    "StaleCleanupDays": "#{Payment_StaleCleanupDays}#",
    "StaleCleanupBatch": "#{Payment_StaleCleanupBatch}#",
    "PayoutAutoRetryHours": "#{Payment_PayoutAutoRetryHours}#",
    "PayoutBatch": "#{Payment_PayoutBatch}#"
  },
  "Iyzico": {
    "ApiKey": "#{Iyzico_ApiKey}#",
    "SecretKey": "#{Iyzico_SecretKey}#",
    "BaseUrl": "#{Iyzico_BaseUrl}#",
    "WebhookSecret": "#{Iyzico_WebhookSecret}#",
    "CallbackUrl": "#{Iyzico_CallbackUrl}#",
    "Locale": "tr"
  },
  "RabbitMq": {
    "Host": "#{RabbitMq_Host}#",
    "VirtualHost": "#{RabbitMq_VirtualHost}#",
    "Username": "#{RabbitMq_Username}#",
    "Password": "#{RabbitMq_Password}#",
    "Port": 5672
  },
  "DistributedCache": {
    "Configuration": "#{ConnectionStrings_Redis}#"
  },
  "DatabaseSettings": {
    "PaymentScheduler": {
      "Type": "PostgreSQL",
      "ConnectionString": "#{DatabaseSettings_PaymentScheduler_ConnectionString}#"
    }
  },
  "Scheduler": {
    "StorageType": "PostgreSQL",
    "RetryAttempts": 3,
    "UseFilter": true,
    "RouteUrl": "/hangfire",
    "DatabaseKey": "PaymentScheduler",
    "SchemaName": "payment-scheduler"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "System": "Error"
      }
    }
  }
}
