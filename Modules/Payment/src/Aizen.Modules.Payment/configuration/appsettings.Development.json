{
  "PaymentSeed": {
    "Enabled": true,
    "SeedEfEntities": true,
    "JsonRootPath": "Seed/Json",
    "FailOnMissingRequiredFile": false
  },
  "DatabaseSettings": {
    "Payment": {
      "Type": "PostgreSQL",
      "ConnectionString": "Host=postgres;Port=5432;Database=inktavia_store;Username=aizen;Password=aizenpw"
    },
    "PaymentScheduler": {
      "Type": "PostgreSQL",
      "ConnectionString": "Host=postgres;Port=5432;Database=inktavia_store;Username=aizen;Password=aizenpw"
    }
  },
  "ConnectionStrings": {
    "Payment": "Host=postgres;Port=5432;Database=inktavia_store;Username=aizen;Password=aizenpw"
  },
  "DistributedCache": {
    "InstanceName": "Payment:",
    "Configuration": "redis:6379,abortConnect=False,defaultDatabase=14"
  },
  "MessageBroker": {
    "QueueSettings": {
      "HostName": "rabbitmq",
      "UserName": "aizen",
      "Password": "aizenpw",
      "Port": 5672,
      "VirtualHost": "/",
      "Debug": false
    }
  },
  "Iyzico": {
    "ApiKey": "sandbox_api_key_placeholder",
    "SecretKey": "sandbox_secret_key_placeholder",
    "BaseUrl": "https://sandbox-api.iyzipay.com",
    "WebhookSecret": "",
    "CallbackUrl": "http://payment-api:5010/payment/callback",
    "Locale": "tr"
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/inktavia-realm",
    "MetadataAddress": "http://keycloak:8080/realms/inktavia-realm/.well-known/openid-configuration",
    "Audience": "payment-api",
    "RequireHttpsMetadata": "false"
  },
  "ErrorLocalization": {
    "Assembly": "Aizen.Modules.Payment",
    "ResourceFolder": "Resource",
    "ResourceFile": "aizen_error_messages.json"
  },
  "ElasticApm": {
    "ServerUrl": "http://localhost:8200",
    "Enabled": false,
    "TransactionIgnoreUrls": "/api/health, /info"
  },
  "Scheduler": {
    "StorageType": "PostgreSQL",
    "RetryAttempts": 3,
    "UseFilter": true,
    "RouteUrl": "/hangfire",
    "DatabaseKey": "PaymentScheduler",
    "SchemaName": "payment-scheduler"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
