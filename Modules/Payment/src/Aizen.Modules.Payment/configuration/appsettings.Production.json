{
  "PaymentSeed": {
    "Enabled": false,
    "SeedEfEntities": false,
    "JsonRootPath": "Seed/Json",
    "FailOnMissingRequiredFile": true
  },
  "DatabaseSettings": {
    "Payment": {
      "Type": "PostgreSQL",
      "ConnectionString": "#{PAYMENT_DB_CONNECTION_STRING}#"
    },
    "PaymentScheduler": {
      "Type": "PostgreSQL",
      "ConnectionString": "#{PAYMENT_DB_CONNECTION_STRING}#"
    }
  },
  "DistributedCache": {
    "InstanceName": "Payment:",
    "Configuration": "#{REDIS_CONNECTION_STRING}#"
  },
  "MessageBroker": {
    "QueueSettings": {
      "HostName": "#{RABBITMQ_HOST}#",
      "UserName": "#{RABBITMQ_USER}#",
      "Password": "#{RABBITMQ_PASS}#",
      "Port": 5672,
      "VirtualHost": "/",
      "Debug": false
    }
  },
  "Iyzico": {
    "ApiKey": "#{IYZICO_API_KEY}#",
    "SecretKey": "#{IYZICO_SECRET_KEY}#",
    "BaseUrl": "https://api.iyzipay.com",
    "WebhookSecret": "#{IYZICO_WEBHOOK_SECRET}#",
    "CallbackUrl": "#{PAYMENT_CALLBACK_URL}#",
    "Locale": "tr"
  },
  "Keycloak": {
    "Authority": "#{KEYCLOAK_AUTHORITY}#",
    "MetadataAddress": "#{KEYCLOAK_METADATA_ADDRESS}#",
    "Audience": "payment-api",
    "RequireHttpsMetadata": "true"
  },
  "ErrorLocalization": {
    "Assembly": "Aizen.Modules.Payment",
    "ResourceFolder": "Resource",
    "ResourceFile": "aizen_error_messages.json"
  },
  "ElasticApm": {
    "ServerUrl": "#{ELASTIC_APM_SERVER_URL}#",
    "TransactionSampleRate": 0.1,
    "Enabled": true,
    "TransactionIgnoreUrls": "/api/health, /info"
  },
  "Scheduler": {
    "StorageType": "PostgreSQL",
    "RetryAttempts": 3,
    "UseFilter": true,
    "RouteUrl": "/hangfire",
    "DatabaseKey": "PaymentScheduler",
    "SchemaName": "payment-scheduler"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
