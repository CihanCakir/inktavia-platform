{
  "PaymentSeed": {
    "Enabled": false,
    "SeedEfEntities": false,
    "JsonRootPath": "Seed/Json",
    "FailOnMissingRequiredFile": true
  },
  "Payment": {
    "//": "N1/N4 notification knobs (deploy-time tunable; code defaults 14 / 10).",
    "PriceChangeReminderLeadDays": 14,
    "BenefitBudgetLowThresholdPercent": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ElasticApm": {
    "ServerUrl": "",
    "TransactionSampleRate": 1.0,
    "CaptureHeaders": "true",
    "CaptureBody": "all",
    "CaptureBodyContentTypes": "application/json*",
    "OpentelemetryBridgeEnabled": false,
    "TransactionIgnoreUrls": "/api/health, /info"
  },
  "DatabaseSettings": {
    "Payment": {
      "Type": "PostgreSQL",
      "ConnectionString": ""
    },
    "PaymentScheduler": {
      "Type": "PostgreSQL",
      "ConnectionString": ""
    }
  },
  "DistributedCache": {
    "InstanceName": "Payment:",
    "Configuration": ""
  },
  "MessageBroker": {
    "QueueSettings": {
      "HostName": "localhost",
      "UserName": "guest",
      "Password": "guest",
      "Port": 5672,
      "VirtualHost": "/",
      "Debug": false
    }
  },
  "Iyzico": {
    "ApiKey": "",
    "SecretKey": "",
    "BaseUrl": "https://sandbox-api.iyzipay.com",
    "WebhookSecret": "",
    "CallbackUrl": "https://localhost:3000/payment/callback",
    "Locale": "tr"
  },
  "Keycloak": {
    "Authority": "",
    "MetadataAddress": "",
    "Audience": "payment-api",
    "RequireHttpsMetadata": "true"
  },
  "ErrorLocalization": {
    "Assembly": "Aizen.Modules.Payment",
    "ResourceFolder": "Resource",
    "ResourceFile": "aizen_error_messages.json"
  },
  "Scheduler": {
    "StorageType": "PostgreSQL",
    "RetryAttempts": 3,
    "UseFilter": true,
    "RouteUrl": "/hangfire",
    "DatabaseKey": "PaymentScheduler",
    "SchemaName": "payment-scheduler"
  }
}
