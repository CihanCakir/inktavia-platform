{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ElasticApm": {
    "ServerUrl": "",
    "TransactionSampleRate": 1.0,
    "CaptureHeaders": "true",
    "CaptureBody": "all",
    "CaptureBodyContentTypes": "application/json*",
    "OpentelemetryBridgeEnabled": false
  },
  "DatabaseSettings": {
    "Profile": {
      "Type": "PostgreSQL",
      "ConnectionString": "Host=localhost;Port=5432;Database=inktavia;Username=postgres;Password=postgres;Search Path=cargodry"
    }
  },
  "DistributedCache": {
    "InstanceName": "Profile:",
    "Configuration": "localhost:6379,abortConnect=False"
  },
  "CargoDry": {
    "ActivationTokenSecret": "REPLACE_WITH_32_CHAR_SECRET_MINIMUM_HERE",
    "BatchKeys": {
      "202506-STAN-AB12": "REPLACE_WITH_BASE64_BATCH_KEY"
    }
  },
  "MessageBroker": {
    "QueueSettings": {
      "HostName": "localhost",
      "UserName": "guest",
      "Password": "guest",
      "Port": 5672,
      "VirtualHost": "/",
      "Debug": false
    }
  },
  "Settings": {
    "TokenSettings": {
      "Issuer": "Aizen.Bpm"
    }
  },
  "TokenOption": {
    "Audience": "www.inktavia.com",
    "Issuer": "www.inktavia.com",
    "AccessTokenExpiration": 43800,
    "RefreshTokenExpiration": 10080,
    "SecurityKey": "mysecuritykeymysecuritykeymysecuritykeymysecuritykey"
  }
}
