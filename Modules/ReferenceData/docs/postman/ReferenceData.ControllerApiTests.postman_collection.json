  "item": [
    {
      "name": "00 - Auth Setup",
      "item": [
        {
          "name": "Get Admin Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "pm.environment.set(\"admin_access_token\", r.access_token);",
                  "pm.environment.set(\"active_access_token\", r.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password" },
                { "key": "client_id", "value": "{{admin_panel_client_id}}" },
                { "key": "username", "value": "{{admin_username}}" },
                { "key": "password", "value": "{{default_password}}" }
              ]
            },
            "url": {
              "raw": "{{keycloak_token_url}}",
              "host": ["{{keycloak_token_url}}"]
            }
          }
        },
        {
          "name": "Set Active - Admin",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set(\"active_access_token\", pm.environment.get(\"admin_access_token\"));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{reference_data_api_base_url}}/health",
              "host": ["{{reference_data_api_base_url}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
