      "item": [
        {
          "name": "Get Mobile Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const r = pm.response.json();",
                  "pm.environment.set(\"mobile_access_token\", r.access_token);",
                  "pm.environment.set(\"active_access_token\", r.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password" },
                { "key": "client_id", "value": "{{mobile_client_id}}" },
                { "key": "username", "value": "{{mobile_username}}" },
                { "key": "password", "value": "{{default_password}}" }
              ]
            },
            "url": { "raw": "{{keycloak_token_url}}", "host": ["{{keycloak_token_url}}"] }
