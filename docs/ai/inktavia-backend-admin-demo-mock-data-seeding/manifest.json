{
  "packageName": "inktavia-backend-admin-demo-mock-data-copilot-package",
  "version": "1.0.0",
  "language": "en",
  "purpose": "Generate relationally consistent JSON mock data and startup seed/import logic for Identity, Vessel, and ServiceRequest modules so the Admin Web can be tested with realistic data.",
  "targetRepository": "Inktavia Marine OS / Aizen backend repository",
  "targetModules": [
    "Aizen.Modules.Identity",
    "Aizen.Modules.Vessel",
    "Aizen.Modules.ServiceRequest"
  ],
  "primaryInstruction": "RUN_THIS_FIRST_SINGLE_PROMPT.md",
  "referenceFiles": [
    "reference/MOCK_DATA_TARGET_MODEL.md",
    "reference/MODULE_RELATIONSHIP_STRATEGY.md",
    "reference/IDENTITY_MOCK_DATA_SPEC.md",
    "reference/VESSEL_MOCK_DATA_SPEC.md",
    "reference/SERVICE_REQUEST_MOCK_DATA_SPEC.md",
    "reference/STARTUP_IMPORT_AND_IDEMPOTENCY_RULES.md",
    "reference/POSTGRES_MONGO_REDIS_SEEDING_RULES.md",
    "reference/ADMIN_WEB_TESTING_SCENARIOS.md",
    "reference/REPORTING_REQUIREMENTS.md"
  ],
  "stepPrompts": [
    "ai/inktavia-backend-admin-demo-mock-data-seeding/00_MASTER_PROMPT.md",
    "ai/inktavia-backend-admin-demo-mock-data-seeding/01_AUDIT_MODULE_DB_CONTEXTS_AND_ENTITIES.md",
    "ai/inktavia-backend-admin-demo-mock-data-seeding/02_DEFINE_CROSS_MODULE_STABLE_IDS_AND_MANIFEST.md",
    "ai/inktavia-backend-admin-demo-mock-data-seeding/03_GENERATE_IDENTITY_MOCK_JSON_AND_SEEDER.md",
    "ai/inktavia-backend-admin-demo-mock-data-seeding/04_GENERATE_VESSEL_MOCK_JSON_AND_SEEDER.md",
    "ai/inktavia-backend-admin-demo-mock-data-seeding/05_GENERATE_SERVICE_REQUEST_MOCK_JSON_AND_SEEDER.md",
    "ai/inktavia-backend-admin-demo-mock-data-seeding/06_WIRE_STARTUP_IMPORT_AND_ENV_GUARDS.md",
    "ai/inktavia-backend-admin-demo-mock-data-seeding/07_VALIDATE_ADMIN_PANEL_BFF_AND_POSTMAN_SCENARIOS.md",
    "ai/inktavia-backend-admin-demo-mock-data-seeding/08_REPORTS_AND_FINAL_GAP_ANALYSIS.md"
  ],
  "requiredReports": [
    "docs/reports/mock-data-module-entity-audit-report.md",
    "docs/reports/mock-data-cross-module-id-manifest-report.md",
    "docs/reports/identity-mock-data-seeding-report.md",
    "docs/reports/vessel-mock-data-seeding-report.md",
    "docs/reports/service-request-mock-data-seeding-report.md",
    "docs/reports/mock-data-startup-import-report.md",
    "docs/reports/admin-panel-demo-data-validation-report.md",
    "docs/reports/mock-data-final-gap-report.md"
  ],
  "hardRules": [
    "Do not invent entity fields; inspect actual entities and DbContexts first.",
    "Do not cross-write into another module's database.",
    "Use Identity UserId as the stable cross-module user reference.",
    "Use deterministic IDs so data can be reseeded idempotently.",
    "Seed only in Local/Development or when explicitly enabled by configuration.",
    "Do not enable mock data seeding by default in staging/production.",
    "Generate JSON files that map to real entity shapes or seed DTOs.",
    "Generate reports for every module and for cross-module relationships."
  ]
}
