  "nonNegotiables": [
    "Read source contract before implementation",
    "Use existing route/controller/envelope/auth patterns as source of truth",
    "Do not return raw domain entities to frontend",
    "Add only missing entity fields",
    "Keep cross-module CargoDry and ServiceRequest integration null-safe",
    "Do not break existing AdminPanel BFF /api/v1/admin-panel route convention",
    "Avoid interface response properties that Refit/System.Text.Json cannot deserialize",
    "Generate reports with evidence and remaining gaps"
