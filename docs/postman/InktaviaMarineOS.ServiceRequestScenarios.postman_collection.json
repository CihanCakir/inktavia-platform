    {
      "name": "01 - Prerequisites - Get Vessel",
      "item": [
        {
          "name": "Get My Vessels (find vesselId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "const items = r.items || r.data || r;",
                  "if (Array.isArray(items) && items.length > 0) {",
                  "  pm.environment.set('vesselId', items[0].id);",
                  "  console.log('vesselId set:', items[0].id);",
                  "} else {",
                  "  console.warn('No vessels found - run Vessel collection first');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{active_access_token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{vessel_api_base_url}}/vessels/current-user?pageIndex=0&pageSize=5",
              "host": ["{{vessel_api_base_url}}"],
              "path": ["vessels", "current-user"],
              "query": [
                { "key": "pageIndex", "value": "0" },
                { "key": "pageSize", "value": "5" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "02 - Prerequisites - Get Currency",
      "item": [
        {
          "name": "Get Currencies (find currencyId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "if (Array.isArray(r) && r.length > 0) {",
                  "  const usd = r.find(c => c.code === 'USD') || r[0];",
                  "  pm.environment.set('currencyId', usd.id);",
                  "  console.log('currencyId set:', usd.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{reference_data_api_base_url}}/currencies?onlyActive=true",
              "host": ["{{reference_data_api_base_url}}"],
              "path": ["currencies"],
              "query": [
                { "key": "onlyActive", "value": "true" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "03 - Create Service Request",
      "item": [
        {
          "name": "Create Service Request (Draft)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const r = pm.response.json();",
                  "pm.environment.set('serviceRequestId', r.id || r.serviceRequestId);",
                  "pm.test('serviceRequestId saved: ' + pm.environment.get('serviceRequestId'), () => pm.expect(pm.environment.get('serviceRequestId')).to.not.be.empty);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{active_access_token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vesselId\": \"{{vesselId}}\",\n  \"title\": \"Engine Overhaul - Full Service\",\n  \"description\": \"Complete engine overhaul required after 10000 operating hours.\",\n  \"serviceType\": \"EngineMaintenance\",\n  \"requiredPort\": \"Istanbul Haydarpasa Terminal\",\n  \"scheduledAt\": \"2025-04-01T08:00:00Z\",\n  \"budgetMin\": 10000,\n  \"budgetMax\": 25000,\n  \"currencyId\": \"{{currencyId}}\",\n  \"attachments\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{service_request_api_base_url}}/service-requests",
              "host": ["{{service_request_api_base_url}}"],
              "path": ["service-requests"]
            }
          }
        },
        {
          "name": "Publish Service Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Published', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{active_access_token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{service_request_api_base_url}}/service-requests/{{serviceRequestId}}/publish",
              "host": ["{{service_request_api_base_url}}"],
              "path": ["service-requests", "{{serviceRequestId}}", "publish"]
            }
          }
        },
        {
          "name": "Verify Published",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('Is published', () => pm.expect(r.status).to.equal('Published'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{active_access_token}}", "type": "text" }
            ],
            "url": {
