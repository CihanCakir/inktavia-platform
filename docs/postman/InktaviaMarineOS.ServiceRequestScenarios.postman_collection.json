  "item": [
    {
      "name": "00 - Prerequisites - Auth",
      "item": [
        {
          "name": "Get Owner Token (Mobile)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "pm.environment.set('mobile_access_token', r.access_token);",
                  "pm.environment.set('active_access_token', r.access_token);",
                  "pm.environment.set('owner_access_token', r.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "client_id", "value": "{{mobile_client_id}}", "type": "text" },
                { "key": "username", "value": "{{mobile_username}}", "type": "text" },
                { "key": "password", "value": "{{default_password}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{keycloak_token_url}}",
              "host": ["{{keycloak_token_url}}"]
            }
          }
        },
        {
          "name": "Get Admin Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "pm.environment.set('admin_access_token', r.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "client_id", "value": "{{admin_panel_client_id}}", "type": "text" },
                { "key": "username", "value": "{{admin_username}}", "type": "text" },
                { "key": "password", "value": "{{default_password}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{keycloak_token_url}}",
              "host": ["{{keycloak_token_url}}"]
            }
          }
        },
        {
          "name": "Identity Login (Owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.environment.set('identityAccessToken', r.identityAccessToken || r.accessToken || '');",
                  "pm.environment.set('X-Aizen-User-Token', r.xAizenUserToken || r.userToken || '');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{mobile_access_token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+905301234567\",\n  \"password\": \"{{default_password}}\",\n  \"deviceId\": \"test-device-001\",\n  \"notificationToken\": \"fcm-test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{identity_api_base_url}}/auth/login/phone",
              "host": ["{{identity_api_base_url}}"],
              "path": ["auth", "login", "phone"]
