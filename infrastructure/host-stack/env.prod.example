# Inktavia host stack — üretim ortam değişkenleri
#
# Bu dosyayı sunucuda /srv/host-stack/.env olarak kopyala ve GERÇEK değerlerle doldur.
# .env ASLA git'e commit edilmez (repo .gitignore'unda zaten dışlanmış).
#
# Parola üretmek için:
#   openssl rand -base64 32 | tr -d '/+=' | head -c 32
# (eğik çizgi ve artı işaretleri connection string'lerde ve JDBC URL'lerinde
#  kaçış gerektirdiği için temizleniyor.)

# Docker'ın portları bağlayacağı adres. 0.0.0.0 YAZMA — Docker yayınlanan portlar
# için UFW'yi atlar, dinlenen adresi burada kısıtlıyoruz.
BIND_IP=192.168.1.50

# ── PostgreSQL (uygulama) ────────────────────────────────────────────
POSTGRES_USER=aizen
POSTGRES_PASSWORD=
POSTGRES_DB=inktavia_store

# ── MongoDB ──────────────────────────────────────────────────────────
MONGO_USER=aizen
MONGO_PASSWORD=

# ── Redis ────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── RabbitMQ ─────────────────────────────────────────────────────────
RABBITMQ_USER=aizen
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/

# ── MinIO ────────────────────────────────────────────────────────────
MINIO_ROOT_USER=inktavia
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_NAME=inktavia-filestorage
# FAZ21 (#78/#82): tarayici presigned PUT'lari DOGRUDAN MinIO'ya gider; yukleyen HER portalin
# origin'i burada olmali. DIKKAT — bu degisken TANIMLIYSA docker-compose.prod.yaml:170'teki
# ${MINIO_CORS_ORIGINS:-...} varsayilani HIC calismaz, buradaki liste onu EZER. 2026-08-22'de
# canli /srv/host-stack/.env tam olarak bu eski satiri tasiyordu ve belge yukleme, deponun
# tamami duzelmis olmasina ragmen preflight'ta asili kaliyordu. Iki dosyayi BIRLIKTE guncelle.
# Degisiklik sonrasi: docker compose up -d minio  (restart YETMEZ — env yalniz yeniden
# olusturulan konteynere gecer).
# https://inktavia.com dusuruldu: marine-web'de tarayicidan depoya giden bir yukleme yolu YOK
# (grep uploadUrl/presign/XMLHttpRequest = 0). Boyle bir yol eklenirse origin geri konmali.
MINIO_CORS_ORIGINS=https://admin.inktavia.com,https://partner.inktavia.com,https://provider.inktavia.com,https://dev-provider.inktavia.com

# ── Keycloak ─────────────────────────────────────────────────────────
KC_DB_USER=keycloak
KC_DB_PASSWORD=
KC_DB_NAME=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_LOG_LEVEL=INFO

# Özel OTP-login authenticator SPI'sinin HMAC sırları.
# Bunlar Identity modülündeki değerlerle AYNI olmak zorunda — uyuşmazsa
# OTP → Keycloak login-ticket devri sessizce başarısız olur.
OTP_LOGIN_TICKET_SECRET=
OTP_LOGIN_CONSUME_SECRET=
