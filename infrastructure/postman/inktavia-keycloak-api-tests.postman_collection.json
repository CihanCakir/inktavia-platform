          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text",
                  "enabled": true
                },
                {
                  "key": "client_id",
                  "value": "{{admin_panel_client_id}}",
                  "type": "text",
                  "enabled": true
                },
                {
                  "key": "username",
                  "value": "{{admin_username}}",
                  "type": "text",
                  "enabled": true
                },
                {
                  "key": "password",
                  "value": "{{default_password}}",
                  "type": "text",
                  "enabled": true
                }
              ]
            },
            "url": {
              "raw": "{{keycloak_token_url}}",
              "host": [
                "{{keycloak_token_url}}"
              ]
            },
            "description": "Local-only token helper. Works only if direct access grant is enabled. Prefer Authorization Code + PKCE for production-like testing."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "",
                  "pm.test(\"Token response contains access_token\", function () {",
                  "  pm.expect(response.access_token).to.be.a(\"string\");",
                  "});",
                  "",
                  "pm.environment.set(\"admin_access_token\", response.access_token);",
                  "pm.environment.set(\"active_access_token\", response.access_token);"
                ]
              }
            }
          ]
        }
