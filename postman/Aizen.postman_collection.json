{
  "info": {
    "name": "Aizen Local APIs",
    "_postman_id": "aizen-local-collection",
    "description": "Postman collection to obtain Keycloak token and call Identity/Profile/Payment module endpoints. Update placeholder Payment/Profile endpoints if different.\n\nNote: Keycloak is expected at http://localhost:8080 (docker-compose). Realm: {{realm}} (default: aizen).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "keycloak_url", "value": "http://localhost:8080" },
    { "key": "realm", "value": "aizen" },
    { "key": "client_id", "value": "identity-client" },
    { "key": "client_secret", "value": "changeme" },
    { "key": "username", "value": "testuser" },
    { "key": "password", "value": "testpassword" },
    { "key": "grant_type", "value": "password" },
    { "key": "access_token", "value": "" },
    { "key": "base_url_identity", "value": "http://localhost:7101" },
    { "key": "base_url_profile", "value": "http://localhost:7102" },
    { "key": "base_url_payment", "value": "http://localhost:7103" }
  ],
  "item": [
    {
      "name": "Auth - Keycloak",
      "item": [
        {
          "name": "Get Token (Password)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "client_id", "value": "{{client_id}}" },
                { "key": "client_secret", "value": "{{client_secret}}", "type": "text" },
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "username", "value": "{{username}}", "type": "text" },
                { "key": "password", "value": "{{password}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": ["{{keycloak_url}}"],
              "path": ["realms", "{{realm}}", "protocol", "openid-connect", "token"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if(json && json.access_token) {",
                  "  pm.collectionVariables.set('access_token', json.access_token);",
                  "  pm.collectionVariables.set('token_type', json.token_type || 'Bearer');",
                  "  pm.test('access_token set', function(){ pm.expect(json.access_token).to.be.a('string'); });",
                  "} else {",
                  "  pm.test('no access_token in response', function(){ pm.expect(typeof json.access_token).to.not.equal('undefined'); });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Token (Client Credentials)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "client_id", "value": "{{client_id}}" },
                { "key": "client_secret", "value": "{{client_secret}}", "type": "text" },
                { "key": "grant_type", "value": "client_credentials", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": ["{{keycloak_url}}"],
              "path": ["realms", "{{realm}}", "protocol", "openid-connect", "token"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if(json && json.access_token) {",
                  "  pm.collectionVariables.set('access_token', json.access_token);",
                  "  pm.collectionVariables.set('token_type', json.token_type || 'Bearer');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Identity",
      "item": [
        {
          "name": "Start External Login (participant)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url_identity}}/api/v1/identity/participant/oauth/start?provider=google&redirect=/&lang=tr",
              "host": ["{{base_url_identity}}"],
              "path": ["api", "v1", "identity", "participant", "oauth", "start"],
              "query": [
                { "key": "provider", "value": "google" },
                { "key": "redirect", "value": "/" },
                { "key": "lang", "value": "tr" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Complete External Login (participant)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "code", "value": "", "type": "text" },
                { "key": "state", "value": "", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url_identity}}/api/v1/identity/participant/oauth/callback/google",
              "host": ["{{base_url_identity}}"],
              "path": ["api", "v1", "identity", "participant", "oauth", "callback", "google"]
            }
          },
          "response": []
        },
        {
          "name": "Register Participant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"phone\": \"+905551112233\",\n  \"password\": \"P@ssw0rd!\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"kvkkAccepted\": true\n}"
            },
            "url": {
              "raw": "{{base_url_identity}}/api/v1/identity/participant/register",
              "host": ["{{base_url_identity}}"],
              "path": ["api", "v1", "identity", "participant", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Register Organizer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"org@example.com\",\n  \"companyName\": \"Acme Ltd\",\n  \"taxNo\": \"1234567890\",\n  \"phone\": \"+905551112234\",\n  \"password\": \"P@ssw0rd!\",\n  \"ownerFirstName\": \"Owner\",\n  \"ownerLastName\": \"Name\",\n  \"kvkkAccepted\": true\n}"
            },
            "url": {
              "raw": "{{base_url_identity}}/api/v1/identity/organizers/register",
              "host": ["{{base_url_identity}}"],
              "path": ["api", "v1", "identity", "organizers", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Register Venue",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"venueName\": \"My Venue\",\n  \"address\": \"Some address\",\n  \"email\": \"venue@example.com\",\n  \"phone\": \"+905551112235\",\n  \"password\": \"P@ssw0rd!\",\n  \"ownerFirstName\": \"Venue\",\n  \"ownerLastName\": \"Owner\",\n  \"kvkkAccepted\": true\n}"
            },
            "url": {
              "raw": "{{base_url_identity}}/api/v1/identity/venues/register",
              "host": ["{{base_url_identity}}"],
              "path": ["api", "v1", "identity", "venues", "register"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Profile (example)",
      "item": [
        {
          "name": "Get Current Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url_profile}}/api/v1/profile/me",
              "host": ["{{base_url_profile}}"],
              "path": ["api", "v1", "profile", "me"]
            }
          },
          "response": []
        }
      ],
      "description": "Update these endpoints with actual controller routes from Modules/Profile project if different."
    },
    {
      "name": "Payment (example)",
      "item": [
        {
          "name": "Get Transactions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url_payment}}/api/v1/payment/transactions",
              "host": ["{{base_url_payment}}"],
              "path": ["api", "v1", "payment", "transactions"]
            }
          },
          "response": []
        }
      ],
      "description": "Placeholder endpoints for Payments module — update after inspecting Controllers under Modules/Payment/src/**/Controller/**."
    }
  ]
}
